{
  "name": "kestrel",
  "version": "0.1.0",
  "private": true,
  "description": "Kestrel — Point. Speak. Done.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @kestrel/desktop",
    "build": "npm run build --workspace @kestrel/desktop",
    "start": "npm run start --workspace @kestrel/desktop",
    "typecheck": "npm run typecheck --workspace @kestrel/desktop",
    "test": "npm run test --workspace @kestrel/desktop",
    "test:all": "npm run test:api && npm run test",
    "test:api": ".\\apps\\api\\.venv\\Scripts\\python.exe -m pytest apps/api -q",
    "api": ".\\apps\\api\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir apps/api --host 127.0.0.1 --port 8765",
    "smoke:notch": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/notch-smoke.ps1"
  }
}
