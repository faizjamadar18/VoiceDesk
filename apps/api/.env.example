# Kestrel API environment.
# Copy this file to `.env` and fill in the values you need. Never commit `.env`.

# --- Groq (planner, screen Q&A, legacy cloud ASR) ---
GROQ_API_KEY=

# Legacy /transcribe provider: fake or groq
KESTREL_ASR_PROVIDER=groq

# --- MCP third-party integrations (Notion) ---
# Master switch. Set to 0 to start Kestrel without any MCP servers.
KESTREL_MCP_ENABLED=1

# Optional: override the config file location. Defaults to apps/api/mcp_servers.json.
# KESTREL_MCP_CONFIG=C:\path\to\mcp_servers.json

# Notion internal integration token. Share each page/database you want Kestrel
# to reach with the integration.
# Create at https://www.notion.so/my-integrations
NOTION_TOKEN=

# --- Local tool retrieval ---
# Narrow MCP tools to the most relevant for each transcript. Built-in tools
# are always sent. On by default; set to 0 to send every tool again.
KESTREL_TOOL_RETRIEVAL=1

# Local embedding model (ONNX, CPU, offline) used to rank MCP tools.
KESTREL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Max non-built-in tools to keep per request.
KESTREL_TOOL_TOP_K=10